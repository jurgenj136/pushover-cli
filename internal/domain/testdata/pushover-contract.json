    "emergency_expire_max_seconds": 10800,
    "emergency_delivery_cap": 50
  },
  "attachment": {
    "max_bytes": 5242880
  },
  "quota_headers": {
    "limit": "X-Limit-App-Limit",
    "remaining": "X-Limit-App-Remaining",
    "reset": "X-Limit-App-Reset"
  },
