#compdef pushover

_pushover() {
  local -a commands global_flags send_flags
  commands=(send completion)
  global_flags=(--profile --json --plain --no-color --timeout)
  send_flags=(--to --title --device --priority --sound --timestamp --ttl --url --url-title --html --monospace --attachment --attachment-url --encrypted --retry --expire --validate --validate-network --dry-run --yes --stdin --file --credentials-stdin)
  if (( CURRENT == 2 )); then
    _describe -t commands 'pushover command' commands
    return
  fi
  case "${words[2]}" in
    send) _describe -t flags 'send flag' send_flags ;;
    completion) _values 'shell' bash zsh fish ;;
  esac
}

_pushover "$@"
